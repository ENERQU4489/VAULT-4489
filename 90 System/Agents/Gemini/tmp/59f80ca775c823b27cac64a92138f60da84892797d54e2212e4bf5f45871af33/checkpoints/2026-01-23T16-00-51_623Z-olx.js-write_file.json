            "name": "write_file",
            "args": {
              "content": "const fs = require('fs');\nconst path = require('path');\n\nconst scrapersDir = path.join(__dirname, 'scrapers');\n\nfs.watch(scrapersDir, (eventType, filename) => {\n  if (filename) {\n    console.log(`File ${filename} in scrapers directory has been ${eventType}d.`);\n    // Here you can add logic to reload the scrapers or restart the application\n  }\n});\n\nconsole.log(`Watching for file changes in ${scrapersDir}`);\n",
              "file_path": "watcher.js"
            }
          }
        }
